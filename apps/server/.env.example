# --- Access control --------------------------------------------------------
# How users sign in:
#   token     (default) one shared PROXY_TOKEN for the plugin and MCP clients
#   nextcloud each Nextcloud user signs in: the plugin with "Mit Nextcloud anmelden" (Login Flow v2),
#             MCP clients with a Nextcloud app password or OAuth via Nextcloud (see below)
#   local     one computer: listens on 127.0.0.1 only, MCP without sign-in (the plugin still uses PROXY_TOKEN)
AUTH_MODE=token
# Shared secret the plugin sends as "Authorization: Bearer <token>" (min. 16 chars).
# Required for token and local; not used for nextcloud. Generate one with: openssl rand -hex 24
PROXY_TOKEN=change-me-to-a-long-random-string
# External URL of this server (as AI clients and browsers reach it), e.g. https://cloud.example.org/worksheet
# Used for the MCP address shown in the plugin and required for OAuth.
# PUBLIC_URL=https://worksheet.example.org
# Origins allowed to call the proxy from the browser (comma separated, no trailing slash).
# This is the origin of the page serving the editor, i.e. your Nextcloud / Euro-Office domain.
CORS_ORIGINS=https://cloud.example.org
# Requests per IP and time window.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
# Set to true (or a list of proxy IPs) when running behind a reverse proxy, so the
# rate limit sees the real client IP.
TRUST_PROXY=false

# --- Nextcloud (AUTH_MODE=nextcloud) ---------------------------------------
# NEXTCLOUD_URL=https://cloud.example.org
# Optional: URL under which this server reaches Nextcloud (e.g. inside a Docker network).
# NEXTCLOUD_INTERNAL_URL=http://nextcloud-aio-apache:11000
# Optional: OAuth sign-in for MCP clients such as claude.ai or ChatGPT. Create a client in Nextcloud under
# Administration settings → Security → OAuth 2.0 clients with the redirect URI <PUBLIC_URL>/oauth/callback.
# NEXTCLOUD_OAUTH_CLIENT_ID=
# NEXTCLOUD_OAUTH_CLIENT_SECRET=
# Directory for sign-ins, OAuth clients and grants (the Docker image uses /data).
# DATA_DIR=data

# --- MCP ---------------------------------------------------------------------
# MCP endpoint <PUBLIC_URL>/mcp for AI clients (Claude, ChatGPT, Le Chat …). "false" switches it off.
# MCP_ENABLED=true

# --- Model -----------------------------------------------------------------
# mistral (default) | openai (any OpenAI-compatible API, e.g. Ollama) | anthropic | mock
# | none (no AI chat in the plugin – only MCP clients bring their own model)
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-latest
# API key of the provider (or MISTRAL_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY).
LLM_API_KEY=
# Optional custom endpoint, e.g. http://ollama:11434/v1 for Ollama.
# LLM_BASE_URL=
# LLM_TEMPERATURE=0.2
# Output token limit per model call. Reasoning models (e.g. current mistral-large-latest)
# use part of it for "thinking" – too low values end in empty answers.
# LLM_MAX_TOKENS=8192
# LLM_TIMEOUT_MS=120000
# reasoning_effort for reasoning models (low | medium | high; "off" = not sent).
# Default for mistral: medium (without it mistral-large-latest may "think" for minutes).
# LLM_REASONING_EFFORT=medium

# --- Agent loop --------------------------------------------------------------
# Maximum tool rounds per user message before the model must answer in text.
MAX_ITERATIONS=6

# --- Pictures ------------------------------------------------------------------
# Sources the AI may search for worksheet pictures: arasaac (pictograms), commons (Wikimedia Commons), own (the
# user's picture folder). "none" switches pictures off. Needs HTTPS access to api.arasaac.org, static.arasaac.org,
# commons.wikimedia.org, upload.wikimedia.org and thumb.wikimedia.org.
# IMAGE_SOURCES=arasaac,commons,own
# Own pictures: with AUTH_MODE=nextcloud a folder in each user's Nextcloud (default Arbeitsblatt-Bilder);
# otherwise an absolute local folder shared by all users (empty = no own pictures).
# IMAGE_FOLDER=Arbeitsblatt-Bilder

# LOG_LEVEL=info
