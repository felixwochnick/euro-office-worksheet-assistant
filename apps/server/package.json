{
  "name": "@worksheet-assistant/server",
  "version": "0.7.0",
  "private": true,
  "description": "Server for the Euro-Office worksheet assistant: AI chat proxy (keeps API keys server-side, runs the tool-calling agent loop) and MCP endpoint.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/src/server.js",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env build/src/server.js",
    "test": "tsc -p tsconfig.json && node --test build/test/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@worksheet-assistant/shared": "workspace:*",
    "fastify": "^5.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9.3",
    "ws": "^8.23.0"
  }
}
