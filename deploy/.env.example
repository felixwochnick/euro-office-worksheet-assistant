# Euro-Office Document Server
EUROOFFICE_VERSION=latest
# Shared with the Nextcloud connector app – generate with: openssl rand -hex 32
JWT_SECRET=
# Absolute path to the built plugin folder on the host (default: ../dist/worksheet-assistant)
# PLUGIN_DIR=/opt/eurooffice-plugins/worksheet-assistant

# Proxy (AI chat + MCP endpoint) – see apps/server/.env.example for all options
# token (shared PROXY_TOKEN) | nextcloud (each user signs in with Nextcloud)
AUTH_MODE=token
PROXY_TOKEN=
# External URL of the proxy, e.g. https://worksheets.example.org (MCP address <PUBLIC_URL>/mcp, OAuth)
PUBLIC_URL=
# AUTH_MODE=nextcloud:
# NEXTCLOUD_URL=https://cloud.example.org
# NEXTCLOUD_OAUTH_CLIENT_ID=
# NEXTCLOUD_OAUTH_CLIENT_SECRET=
CORS_ORIGINS=https://office.example.org
# mistral | openai | anthropic | none (MCP only, no AI chat in the plugin)
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-latest
# Reverse proxies whose X-Forwarded-For is trusted (for correct client IPs in the rate limits).
# Default here: loopback and private networks (e.g. Traefik/Caddy in Docker). Use an exact IP/CIDR if you can.
# TRUST_PROXY=loopback,uniquelocal
# Worksheet pictures (ARASAAC pictograms, Wikimedia Commons, own pictures): arasaac,commons,own (default) or none.
# Own pictures: folder in each user's Nextcloud (AUTH_MODE=nextcloud), default Arbeitsblatt-Bilder.
# IMAGE_SOURCES=arasaac,commons,own
# IMAGE_FOLDER=Arbeitsblatt-Bilder
LLM_API_KEY=
