# Euro-Office Document Server
EUROOFFICE_VERSION=latest
# Shared with the Nextcloud connector app – generate with: openssl rand -hex 32
JWT_SECRET=
# Absolute path to the built plugin folder on the host (default: ../dist/worksheet-assistant)
# PLUGIN_DIR=/opt/eurooffice-plugins/worksheet-assistant

# LLM proxy
PROXY_TOKEN=
CORS_ORIGINS=https://office.example.org
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-latest
# IP/CIDR of the reverse proxy in front of music-proxy (for correct client IPs in the rate limit)
# TRUST_PROXY=172.16.0.0/12
LLM_API_KEY=
