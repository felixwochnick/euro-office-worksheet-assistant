{
  "name": "euro-office-worksheet-assistant",
  "version": "0.6.0",
  "private": true,
  "description": "Euro-Office (ONLYOFFICE) worksheet assistant: panel plugin with AI chat, MCP endpoint and a desktop app.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:plugin && npm run build:server",
    "build:plugin": "bash scripts/build.sh",
    "build:server": "npm run build -w @worksheet-assistant/server",
    "build:companion": "node scripts/build-companion.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:website": "npm run build -w @worksheet-assistant/website",
    "test": "npm test -w @worksheet-assistant/shared -w @worksheet-assistant/server",
    "test:shared": "npm test -w @worksheet-assistant/shared",
    "harness": "bash scripts/build.sh && node scripts/serve.mjs",
    "e2e": "node apps/plugin/harness/e2e.mjs",
    "e2e:real": "node dev/eurooffice/e2e-real-editor.mjs",
    "dev:server": "npm run dev -w @worksheet-assistant/server",
    "dev:desktop": "npm run tauri -w @worksheet-assistant/desktop -- dev",
    "dev:website": "npm run dev -w @worksheet-assistant/website"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "postject": "^1.0.0-alpha.6"
  }
}
