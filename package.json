{
  "name": "euro-office-worksheet-assistant",
  "version": "0.8.2",
  "private": true,
  "description": "Euro-Office (ONLYOFFICE) worksheet assistant: panel plugin with AI chat, MCP endpoint and a desktop app.",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm build:plugin && pnpm build:server",
    "build:plugin": "bash scripts/build.sh",
    "build:server": "pnpm --filter @worksheet-assistant/server build",
    "build:companion": "node scripts/build-companion.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:website": "pnpm --filter @worksheet-assistant/website build",
    "test": "pnpm --filter @worksheet-assistant/shared --filter @worksheet-assistant/server test",
    "test:shared": "pnpm --filter @worksheet-assistant/shared test",
    "harness": "bash scripts/build.sh && node scripts/serve.mjs",
    "e2e": "node apps/plugin/harness/e2e.mjs",
    "e2e:real": "node dev/eurooffice/e2e-real-editor.mjs",
    "dev:server": "pnpm --filter @worksheet-assistant/server dev",
    "dev:desktop": "pnpm --filter @worksheet-assistant/desktop tauri dev",
    "dev:website": "pnpm --filter @worksheet-assistant/website dev"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "postject": "^1.0.0-alpha.6",
    "three": "0.187.0"
  }
}
