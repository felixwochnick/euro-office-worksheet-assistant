{
  "name": "music-notation-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "LLM proxy for the Euro-Office music notation plugin (keeps API keys server-side, runs the tool-calling agent loop).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/src/server.js",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env build/src/server.js",
    "test": "tsc -p tsconfig.json && node --test build/test/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
